# syntax=docker/dockerfile:1.7
# CoTeach production image — multi-stage build.
#
# Stages:
#   1. deps    — install node_modules (incl. workspace packages + prisma client)
#   2. builder — run `next build` to produce `.next/standalone`
#   3. runner  — minimal runtime image, non-root, with healthcheck
#
# The runner image is self-contained: it can be promoted across environments
# without rebuilding, with runtime config supplied via env vars / env_file.

# ============================================================================
# Stage 1: deps
# ============================================================================
FROM node:22-alpine AS deps

# libc6-compat: required by some native modules on alpine.
# python3 / make / g++: build tools for `sharp` (and any other native addon
# that does not ship a prebuilt binary for linuxmusl-x64).
RUN apk add --no-cache libc6-compat python3 make g++

# Enable pnpm via corepack (Node 22 ships corepack).
RUN corepack enable && corepack prepare pnpm@10.4.1 --activate

WORKDIR /app

# Copy only the manifests needed for `pnpm install --frozen-lockfile` so the
# layer is cached across source changes.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches/ ./patches/
COPY packages/ ./packages/
# The migrator is also a distributed image and inherits this stage.
COPY THIRD_PARTY_NOTICES.md ./THIRD_PARTY_NOTICES.md
COPY LICENSE NOTICE ./
COPY licenses/ ./licenses/

# `postinstall` builds the workspace packages (mathml2omml, pptxgenjs,
# @openmaic/*) and runs `prisma generate`. The latter requires the schema, so
# copy the prisma directory too. `scripts/sync-maic-importer.mjs` and
# `scripts/run-prisma.mjs` are invoked by postinstall and must also be present.
COPY prisma ./prisma
COPY scripts/sync-maic-importer.mjs scripts/run-prisma.mjs ./scripts/
COPY src/lib/browser/pdf-runtime-version.json ./src/lib/browser/pdf-runtime-version.json

# Install with the frozen lockfile. `--ignore-scripts` is NOT used because
# postinstall builds the workspace packages the app imports at runtime.
RUN pnpm install --frozen-lockfile

# ============================================================================
# Migration image
# ============================================================================
FROM deps AS migrator

COPY scripts/init-teacher.ts ./scripts/init-teacher.ts
COPY src/lib/db/client.ts ./src/lib/db/client.ts
COPY src/lib/auth/password.ts ./src/lib/auth/password.ts
COPY deploy/container-entrypoint.sh /usr/local/bin/openpbl-entrypoint
RUN chmod 0555 /usr/local/bin/openpbl-entrypoint

ENTRYPOINT ["/usr/local/bin/openpbl-entrypoint"]
CMD ["pnpm", "exec", "prisma", "migrate", "deploy"]

# ============================================================================
# Stage 2: builder
# ============================================================================
FROM node:22-alpine AS builder

RUN apk add --no-cache util-linux
RUN corepack enable && corepack prepare pnpm@10.4.1 --activate

WORKDIR /app

ARG OPENPBL_DEPLOYMENT_ID
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_DEPLOYMENT_ID=$OPENPBL_DEPLOYMENT_ID

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY . .
# The importer browser bundle is generated by the deps-stage postinstall.
# It is intentionally not tracked in Git, so carry the generated artifact
# into the builder explicitly.
COPY --from=deps /app/public/vendor/maic-importer ./public/vendor/maic-importer
COPY --from=deps /app/public/vendor/pdfjs ./public/vendor/pdfjs

# Containers keep the conventional `.next` path used by the copy steps below.
# Local `pnpm build` defaults to `.next-build` so it cannot invalidate a
# concurrently running `next dev` server under `.next/dev`.
RUN NEXT_DIST_DIR=.next pnpm build

# ============================================================================
# Stage 3: runner
# ============================================================================
FROM node:22-alpine AS runner

ARG OPENPBL_DEPLOYMENT_ID

LABEL org.opencontainers.image.title="coteach-app" \
      org.opencontainers.image.description="CoTeach — AI-powered collaborative teaching platform for project-based learning" \
      org.opencontainers.image.source="https://github.com/050603/CoTeach-OpenSource" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="0.1.0"

# Runtime dependencies:
#   - libvips: required by `sharp` for image optimization at runtime.
#     (renamed from `libvips` to `vips` in Alpine 3.24)
#   - wget: used by the HEALTHCHECK directive.
#   - tini: tiny init that reaps zombies and forwards signals (Next.js server
#     is a single process so this is mostly defensive; STOPSIGNAL below still
#     works without tini).
#   - LibreOffice Impress: optional PPTX-to-PDF compatibility path for
#     controlled templates. New-system classroom upload requires teacher-
#     exported PDF by default. Noto CJK and Liberation provide common fallbacks.
RUN apk add --no-cache \
    vips wget tini su-exec \
    libreoffice-impress font-noto-cjk font-liberation chromium

WORKDIR /app

ENV NODE_ENV=production \
    KEEP_ALIVE_TIMEOUT=65000 \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_DEPLOYMENT_ID=$OPENPBL_DEPLOYMENT_ID \
    OPENPBL_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser \
    HOSTNAME=0.0.0.0 \
    PORT=3000

# Create a non-root user/group (uid/gid 1001) for the server process.
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs nextjs

# Copy the standalone server output (includes a minimal node_modules tree).
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
# Standalone does NOT copy `public` or `.next/static` automatically; both are
# required for the app to serve static assets correctly.
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Preserve the checked-in notices in binary distributions. Review additional
# bundled dependency licenses/source obligations before publishing an image.
COPY --from=builder --chown=nextjs:nodejs /app/THIRD_PARTY_NOTICES.md ./THIRD_PARTY_NOTICES.md
COPY --from=builder --chown=nextjs:nodejs /app/LICENSE /app/NOTICE ./
COPY --from=builder --chown=nextjs:nodejs /app/licenses ./licenses
COPY --from=builder --chown=nextjs:nodejs /app/packages/@openmaic/dsl/LICENSE ./licenses/workspace/openmaic-dsl-LICENSE
COPY --from=builder --chown=nextjs:nodejs /app/packages/@openmaic/generation/LICENSE ./licenses/workspace/openmaic-generation-LICENSE
COPY --from=builder --chown=nextjs:nodejs /app/packages/@openmaic/importer/LICENSE ./licenses/workspace/openmaic-importer-LICENSE
COPY --from=builder --chown=nextjs:nodejs /app/packages/@openmaic/renderer/LICENSE ./licenses/workspace/openmaic-renderer-LICENSE
COPY --from=builder --chown=nextjs:nodejs /app/packages/mathml2omml/LICENSE ./licenses/workspace/mathml2omml-LICENSE
COPY --from=builder --chown=nextjs:nodejs /app/packages/omml2mathml/LICENSE ./licenses/workspace/omml2mathml-LICENSE
COPY --from=builder --chown=nextjs:nodejs /app/packages/pptxgenjs/LICENSE ./licenses/workspace/pptxgenjs-LICENSE

# Prisma migrations directory — `prisma migrate deploy` reads these at startup
# (or via `pnpm db:migrate:prod`). The Prisma client itself is already in the
# standalone node_modules tree, but migrations are not traced.
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma

# Reference env file (non-secret). Operators copy this to `.env` and fill in
# real values; the app does NOT read .env.example at runtime.
COPY --chown=nextjs:nodejs .env.example ./.env.example
COPY deploy/container-entrypoint.sh /usr/local/bin/openpbl-entrypoint

# Persistent upload directory — mount a volume here in docker-compose so
# uploaded files survive container restarts.
RUN chmod 0555 /usr/local/bin/openpbl-entrypoint && \
    mkdir -p .openpbl-data/uploads .openpbl-data/whiteboards \
      .openpbl-data/interactive-runtime-cache data/classrooms && \
    chown -R nextjs:nodejs .openpbl-data data

# Graceful shutdown: SIGTERM triggers the instrumentation.ts handler which
# drains in-flight requests, closes the WebSocket server, disconnects Prisma,
# then exits 0 within the budget defined in lib/runtime/lifecycle.ts.
STOPSIGNAL SIGTERM

EXPOSE 3000

# Liveness probe: hit the lightweight `/api/health/live` endpoint. The
# `start-period` gives the app 30s to boot before probes can fail the
# container; `retries: 3` with 5s timeout tolerates transient blips.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -qO- http://127.0.0.1:3000/api/health/live || exit 1

# The entrypoint reads Docker secrets before dropping privileges to nextjs.
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/openpbl-entrypoint"]
CMD ["node", "server.js"]
