{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/course-generation-acceptance/**/*.ts",
    "*.config.ts",
    "*.config.mts",
    ".next-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "OpenMAIC-main",
    "packages/**/src",
    "packages/docs",
    "e2e",
    ".next/dev",
    ".next-build/dev"
  ]
}
