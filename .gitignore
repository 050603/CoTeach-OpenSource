# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
# Research manuscripts, execution reports and historical implementation notes.
# Maintain current contracts and runbooks through docs/README.md.
/docs/paper/
/docs/plans/
/docs/audits/
/docs/reports/
/docs/verification/
/docs/research/
/playwright/.cache/
/.cache/
/artifacts/

# next.js
/.next/
/.next-*/
/out/

# production
/build
/output/

# Generated self-contained Node worker artifacts
/workers/

# generated browser bundles (rebuilt by postinstall)
/public/vendor/maic-importer/
/public/vendor/pdfjs/

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
.netrc
.git-credentials
.aws/
.ssh/
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
# Browser authentication state can contain live sessions.
/playwright/.auth/
**/storageState*.json
**/storage-state*.json

# debug
core.[0-9]*
*.log
*.cpuprofile
*.heapprofile
*.heapsnapshot
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-dev*.log
/deploy/secrets/
/deploy/.deploy.env
/deploy/reports/
/tests/load/reports/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# openPBL local demo state and AI provider secrets
.openpbl-data/
.openpbl-runtime/

# runtime data and generated assets (classrooms, audio, media)
/data/

# local AI provider secrets (use server-providers.example.yml as template)
/server-providers.yml

# IDE / editor local state
.trae/
.DS_Store

# backup files
*.bak
*.backup
*.orig
*.rej
*~
src/middleware-openmaic.ts.bak

# database backups
/backups/

# Python inference runtime bytecode
__pycache__/
*.py[cod]

# Generated workspace package bundles and retired reference tools.
/packages/*/dist/
/packages/@openmaic/*/dist/
/packages/@openmaic/importer/src1/
/tools/course-quality-lab/
