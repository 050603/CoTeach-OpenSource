// CoTeach V2 database schema.
// This schema intentionally has no Legacy/compatibility models. The V2 data
// model is rebuilt from scratch around CourseOffering, Activity, ClassroomInstance,
// ClassroomParticipation and LearningEvent.

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity and authentication
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(uuid())
  username         String
  usernameKey      String    @unique
  displayName      String
  passwordHash     String
  recoveryCodeHash String?
  role             String    @default("STUDENT")
  status           String    @default("ACTIVE")
  sessionVersion   Int       @default(1)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  passwordResetTokens           PasswordResetToken[]
  passwordResetRequests         StudentPasswordResetRequest[] @relation("StudentResetRequester")
  passwordResetsApproved        StudentPasswordResetRequest[] @relation("StudentResetApprover")
  courseTeachers                CourseTeacher[]
  invitationsCreated            CourseInvitation[]            @relation("InvitationCreator")
  enrollments                   Enrollment[]
  templateOwners                ClassroomTemplate[]
  groupMemberships              GroupMember[]
  workPlanItems                 WorkPlanItem[]
  announcementReplies           AnnouncementReply[]
  todoCompletions               TodoCompletion[]
  uploadedFiles                 FileAsset[]                   @relation("FileUploader")
  aiConversations               AiConversation[]
  aiMessages                    AiMessage[]
  aiTasks                       AiTask[]
  confirmationsRequested        AiActionConfirmation[]        @relation("ConfirmationRequester")
  confirmationsDecided          AiActionConfirmation[]        @relation("ConfirmationDecider")
  supportRecords                AiSupportRecord[]             @relation("SupportCreator")
  learningSignals               LearningSignal[]
  interventions                 Intervention[]                @relation("InterventionCreator")
  agentDirectives               TeacherAgentDirective[]       @relation("DirectiveCreator")
  learningEvents                LearningEvent[]
  aiInteractionEvents           AiInteractionEvent[]
  domainEvents                  DomainEvent[]                 @relation("DomainEventActor")
  announcementsCreated          Announcement[]                @relation("AnnouncementCreator")
  evaluationTargets             Evaluation[]                  @relation("EvaluationStudent")
  evaluationsGiven              Evaluation[]                  @relation("EvaluationEvaluator")
  resourcesCreated              Resource[]                    @relation("ResourceCreator")
  todosCreated                  Todo[]                        @relation("TodoCreator")
  reflections                   Reflection[]                  @relation("ReflectionAuthor")
  providerCredentials           ProviderCredential[]          @relation("CredentialOwner")
  loadTestRuns                  LoadTestRun[]                 @relation("LoadTestInitiator")
  maintainedTextbooks           Textbook[]                    @relation("TextbookMaintainer")
  publicDiscussionsCreated      PublicDiscussionSession[]     @relation("PublicDiscussionCreator")
  publicDiscussionsAssigned     PublicDiscussionSession[]     @relation("PublicDiscussionStudent")
  publicDiscussionSoundSessions PublicDiscussionSession[]     @relation("PublicDiscussionSoundOwner")
  publicDiscussionTurns         PublicDiscussionTurn[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model StudentPasswordResetRequest {
  id           String    @id @default(uuid())
  userId       String
  requestHash  String    @unique
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  approvedAt   DateTime?
  approvedById String?
  offeringId   String?
  usedAt       DateTime?
  cancelledAt  DateTime?

  user       User            @relation("StudentResetRequester", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?           @relation("StudentResetApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  offering   CourseOffering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Long-lived course structure
// ---------------------------------------------------------------------------

model CourseOffering {
  id            String    @id @default(uuid())
  name          String
  description   String?   @db.Text
  term          String?
  startsAt      DateTime?
  endsAt        DateTime?
  coverImageUrl String?
  status        String    @default("DRAFT")
  settings      Json?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?

  teachers              CourseTeacher[]
  invitations           CourseInvitation[]
  passwordResetRequests StudentPasswordResetRequest[]
  enrollments           Enrollment[]
  chapters              Chapter[]
  // ClassroomInstance resolves its offering through Activity -> Chapter.
  groups                ProjectGroup[]
  announcements         Announcement[]
  resources             Resource[]
  todos                 Todo[]
  conversations         AiConversation[]
  aiTasks               AiTask[]
  confirmations         AiActionConfirmation[]
  supportRecords        AiSupportRecord[]
  learningSignals       LearningSignal[]
  interventions         Intervention[]
  agentDirectives       TeacherAgentDirective[]
  learningEvents        LearningEvent[]
  aiInteractionEvents   AiInteractionEvent[]
  domainEvents          DomainEvent[]
  fileAssets            FileAsset[]

  @@index([status, startsAt])
}

model CourseTeacher {
  id         String   @id @default(uuid())
  userId     String
  offeringId String
  role       String   @default("TEACHER")
  createdAt  DateTime @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([userId, offeringId])
  @@index([offeringId, role])
}

model CourseInvitation {
  id          String    @id @default(uuid())
  offeringId  String
  code        String    @unique
  status      String    @default("ACTIVE")
  expiresAt   DateTime?
  maxUses     Int?
  useCount    Int       @default(0)
  createdById String?
  createdAt   DateTime  @default(now())
  disabledAt  DateTime?

  offering  CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([offeringId, status])
}

model Enrollment {
  id          String    @id @default(uuid())
  userId      String
  offeringId  String
  status      String    @default("ACTIVE")
  joinedAt    DateTime  @default(now())
  withdrawnAt DateTime?
  completedAt DateTime?
  researchKey String    @unique @default(uuid())

  user                  User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  offering              CourseOffering                   @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  submissions           ActivitySubmission[]
  activityProgress      ActivityProgress[]
  participations        ClassroomParticipation[]
  experimentSubmissions ExperimentAssessmentSubmission[]
  experimentAssignments ExperimentAssessmentAssignment[]
  learningEvents        LearningEvent[]
  learningSignals       LearningSignal[]
  interventions         Intervention[]

  @@unique([userId, offeringId])
  @@index([offeringId, status])
}

model Chapter {
  id          String    @id @default(uuid())
  offeringId  String
  title       String
  description String?   @db.Text
  position    Int
  isOpen      Boolean   @default(false)
  opensAt     DateTime?
  archivedAt  DateTime?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  offering       CourseOffering  @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  activities     Activity[]
  learningEvents LearningEvent[]

  @@unique([offeringId, position])
  @@index([offeringId, isOpen])
}

model Activity {
  id          String    @id @default(uuid())
  chapterId   String
  type        String
  title       String
  description String?   @db.Text
  position    Int
  isOpen      Boolean   @default(false)
  opensAt     DateTime?
  config      Json?
  archivedAt  DateTime?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chapter            Chapter              @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  submissions        ActivitySubmission[]
  progress           ActivityProgress[]
  classroomInstances ClassroomInstance[]
  evaluations        Evaluation[]
  reflections        Reflection[]
  todos              Todo[]
  resources          Resource[]
  workPlanItems      WorkPlanItem[]
  learningEvents     LearningEvent[]

  @@unique([chapterId, position])
  @@index([chapterId, type, isOpen])
}

model ActivityProgress {
  id             String    @id @default(uuid())
  enrollmentId   String
  activityId     String
  status         String    @default("NOT_STARTED")
  startedAt      DateTime?
  completedAt    DateTime?
  lastAccessedAt DateTime?
  progressData   Json?
  updatedAt      DateTime  @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  activity   Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, activityId])
  @@index([enrollmentId, status])
}

// ---------------------------------------------------------------------------
// Reusable classroom content and classroom runs
// ---------------------------------------------------------------------------

// Immutable attempts; ActivityProgress remains the latest-state projection.
model ActivitySubmission {
  id               String   @id @default(uuid())
  enrollmentId     String
  activityId       String
  researchKey      String
  activityVersion  Int
  activitySnapshot Json
  payload          Json
  submittedAt      DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  activity   Activity   @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@index([enrollmentId, activityId, submittedAt])
  @@index([activityId, submittedAt, id])
}

model ClassroomTemplate {
  id          String   @id @default(uuid())
  ownerId     String
  title       String
  description String?  @db.Text
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner              User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions           ClassroomTemplateVersion[]
  textbookBindings   CourseTextbookBinding[]
  evidenceSnapshots  CourseEvidenceSnapshot[]
  preparationSession CoursePreparationSession?

  @@index([ownerId, status])
}

// Teacher-private collaborative planning. Kept outside published course snapshots.
model CoursePreparationSession {
  id                String   @id @default(uuid())
  templateId        String   @unique
  ownerId           String
  revision          Int      @default(0)
  status            String   @default("DISCUSSING")
  state             Json
  confirmedSnapshot Json?
  error             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  template ClassroomTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  turns    CoursePreparationTurn[]

  @@index([ownerId, updatedAt])
}

model CoursePreparationTurn {
  id             String    @id @default(uuid())
  sessionId      String
  requestId      String
  revision       Int
  action         String
  status         String    @default("PENDING")
  userMessage    String    @db.Text
  request        Json
  result         Json?
  error          String?   @db.Text
  executionId    String?
  leaseExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  session CoursePreparationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, requestId])
  @@index([sessionId, revision])
}

model ClassroomTemplateVersion {
  id         String   @id @default(uuid())
  templateId String
  version    Int
  status     String   @default("DRAFT")
  snapshot   Json
  mediaRefs  Json?
  createdAt  DateTime @default(now())

  template  ClassroomTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  instances ClassroomInstance[]

  @@unique([templateId, version])
  @@index([templateId, status])
}

model ClassroomInstance {
  id                String    @id @default(uuid())
  activityId        String
  templateVersionId String
  status            String    @default("SCHEDULED")
  runNo             Int       @default(1)
  runtimeConfig     Json?
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  activity              Activity                         @relation(fields: [activityId], references: [id], onDelete: Restrict)
  templateVersion       ClassroomTemplateVersion         @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  participations        ClassroomParticipation[]
  experimentSubmissions ExperimentAssessmentSubmission[]
  experimentAssignments ExperimentAssessmentAssignment[]
  announcements         Announcement[]
  learningEvents        LearningEvent[]
  domainEvents          DomainEvent[]
  publicDiscussions     PublicDiscussionSession[]
  peerReviewAssignments PeerReviewAssignment[]

  @@unique([activityId, runNo])
  @@index([status, startedAt])
}

// One immutable pretest and posttest response per student and classroom run.
// The research key permits pairing without exporting student identities.
model ExperimentAssessmentAssignment {
  id           String   @id @default(uuid())
  instanceId   String
  enrollmentId String
  variant      String
  pretestForm  Json
  posttestForm Json
  assignedAt   DateTime @default(now())

  instance    ClassroomInstance                @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  enrollment  Enrollment                       @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  submissions ExperimentAssessmentSubmission[]
  drafts      ExperimentAssessmentDraft[]

  @@unique([instanceId, enrollmentId])
  @@index([instanceId, variant])
}

model ExperimentAssessmentSubmission {
  id             String   @id @default(uuid())
  instanceId     String
  enrollmentId   String
  assignmentId   String
  phase          String
  researchKey    String
  questionnaire  Json
  answers        Json
  objectiveScore Int
  objectiveTotal Int
  submittedAt    DateTime @default(now())

  instance   ClassroomInstance              @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  enrollment Enrollment                     @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  assignment ExperimentAssessmentAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@unique([instanceId, enrollmentId, phase])
  @@index([instanceId, phase, submittedAt])
  @@index([enrollmentId, submittedAt])
}

model ExperimentAssessmentDraft {
  id           String   @id @default(uuid())
  assignmentId String
  phase        String
  answers      Json
  currentPage  Int      @default(0)
  version      Int      @default(1)
  startedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment ExperimentAssessmentAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, phase])
  @@index([phase, updatedAt])
}

// Whole-class AI discussions are separate from private student tutor chats.
// Every enrolled student may read the transcript; recommendation evidence is
// exposed only by teacher-scoped API responses.
model PublicDiscussionSession {
  id                  String    @id @default(uuid())
  classroomInstanceId String
  createdById         String
  currentStudentId    String?
  knowledgePointId    String
  topic               String
  mode                String
  openingPrompt       String    @db.Text
  status              String    @default("INVITING")
  resumeStatus        String?
  version             Int       @default(1)
  roundCount          Int       @default(0)
  candidateEvidence   Json?
  soundOwnerId        String?
  soundClientId       String?
  soundLeaseUntil     DateTime?
  keyConclusion       String?   @db.Text
  misconceptionRepair String?   @db.Text
  transferQuestion    String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  endedAt             DateTime?

  classroomInstance ClassroomInstance      @relation(fields: [classroomInstanceId], references: [id], onDelete: Cascade)
  createdBy         User                   @relation("PublicDiscussionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  currentStudent    User?                  @relation("PublicDiscussionStudent", fields: [currentStudentId], references: [id], onDelete: SetNull)
  soundOwner        User?                  @relation("PublicDiscussionSoundOwner", fields: [soundOwnerId], references: [id], onDelete: SetNull)
  turns             PublicDiscussionTurn[]

  @@index([classroomInstanceId, status, updatedAt])
  @@index([currentStudentId, updatedAt])
  @@index([soundOwnerId, soundLeaseUntil])
}

model PublicDiscussionTurn {
  id              String   @id @default(uuid())
  sessionId       String
  studentId       String?
  clientRequestId String   @unique
  sequence        Int
  role            String
  content         String   @db.Text
  source          String   @default("TEXT")
  createdAt       DateTime @default(now())

  session PublicDiscussionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User?                   @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([sessionId, sequence])
  @@index([sessionId, createdAt])
  @@index([studentId, createdAt])
}

model ClassroomParticipation {
  aiTaskRequestAliases AiTaskRequestAlias[]
  id                   String               @id @default(uuid())
  instanceId           String
  enrollmentId         String
  firstEnteredAt       DateTime?
  lastEnteredAt        DateTime?
  completedAt          DateTime?
  stageProgress        Json?

  instance            ClassroomInstance        @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  enrollment          Enrollment               @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  workspace           StudentProjectWorkspace?
  submissions         ClassroomSubmission[]
  artifacts           Artifact[]
  showcases           ShowcasePresentation[]
  reflections         Reflection[]
  evaluations         Evaluation[]
  groups              GroupMember[]
  conversations       AiConversation[]
  supportRecords      AiSupportRecord[]
  learningSignals     LearningSignal[]
  interventions       Intervention[]
  peerReviewsGiven    PeerReviewAssignment[]   @relation("PeerReviewer")
  peerReviewsReceived PeerReviewAssignment[]   @relation("PeerTarget")
  agentDirectives     TeacherAgentDirective[]
  learningEvents      LearningEvent[]
  aiInteractionEvents AiInteractionEvent[]
  domainEvents        DomainEvent[]

  @@unique([instanceId, enrollmentId])
  @@index([enrollmentId, lastEnteredAt])
}

model StudentProjectWorkspace {
  id              String   @id @default(uuid())
  participationId String   @unique
  status          String   @default("ACTIVE")
  projectState    Json?
  aiMembers       Json?
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participation ClassroomParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
}

model GenerationJob {
  id            String    @id @default(uuid())
  targetType    String
  targetId      String
  jobType       String
  status        String    @default("PENDING")
  step          String?
  progress      Int       @default(0)
  request       Json?
  result        Json?
  trace         Json?
  qualityReport Json?
  error         String?   @db.Text
  attempt       Int       @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  heartbeatAt   DateTime?
  retryAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  checkpoints GenerationCheckpoint[]

  @@index([targetType, targetId, status])
  @@index([status, heartbeatAt])
}

model GenerationCheckpoint {
  id        String   @id @default(uuid())
  jobId     String
  step      String
  state     Json
  createdAt DateTime @default(now())

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, step])
}

// ---------------------------------------------------------------------------
// Durable textbook library, evidence graph, and course evidence snapshots
// ---------------------------------------------------------------------------

model Textbook {
  id                String    @id @default(uuid())
  title             String
  author            String?
  description       String?   @db.Text
  maintainerId      String
  status            String    @default("ACTIVE")
  currentRevisionId String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  archivedAt        DateTime?

  maintainer      User               @relation("TextbookMaintainer", fields: [maintainerId], references: [id], onDelete: Restrict)
  revisions       TextbookRevision[] @relation("TextbookRevisions")
  currentRevision TextbookRevision?  @relation("CurrentTextbookRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([maintainerId, status])
}

model TextbookRevision {
  id                String    @id @default(uuid())
  textbookId        String
  revision          Int
  fileAssetId       String    @unique
  sha256            String    @unique
  status            String    @default("PENDING")
  parseVersion      String
  extractionVersion String
  error             String?   @db.Text
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  readyAt           DateTime?

  textbook         Textbook                  @relation("TextbookRevisions", fields: [textbookId], references: [id], onDelete: Cascade)
  currentFor       Textbook[]                @relation("CurrentTextbookRevision")
  fileAsset        FileAsset                 @relation("TextbookRevisionSource", fields: [fileAssetId], references: [id], onDelete: Restrict)
  sections         TextbookSection[]
  sourceBlocks     TextbookSourceBlock[]
  concepts         TextbookConcept[]
  conceptRelations TextbookConceptRelation[]
  examples         TextbookExample[]
  figures          TextbookFigure[]
  retrievalItems   TextbookRetrievalItem[]
  courseBindings   CourseTextbookBinding[]

  @@unique([textbookId, revision])
  @@index([textbookId, status, createdAt])
  @@index([status, updatedAt])
}

model TextbookSection {
  id         String   @id @default(uuid())
  revisionId String
  parentId   String?
  title      String
  path       String
  kind       String   @default("FRONT_MATTER")
  level      Int
  position   Int
  metadata   Json?
  createdAt  DateTime @default(now())

  revision       TextbookRevision        @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  parent         TextbookSection?        @relation("TextbookSectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       TextbookSection[]       @relation("TextbookSectionTree")
  sourceBlocks   TextbookSourceBlock[]
  concepts       TextbookConcept[]
  examples       TextbookExample[]
  figures        TextbookFigure[]
  retrievalItems TextbookRetrievalItem[]
  courseBindings CourseTextbookSection[]

  @@unique([revisionId, path])
  @@unique([revisionId, position])
  @@index([revisionId, parentId, position])
  @@index([revisionId, kind, position])
}

model TextbookSourceBlock {
  id                String   @id @default(uuid())
  revisionId        String
  sectionId         String
  blockKey          String
  blockType         String
  position          Int
  content           String   @db.Text
  normalizedContent String?  @db.Text
  metadata          Json?
  createdAt         DateTime @default(now())

  revision         TextbookRevision          @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  section          TextbookSection           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  conceptEvidence  TextbookConceptEvidence[]
  relationEvidence TextbookConceptRelation[]
  examples         TextbookExample[]
  figures          TextbookFigure[]
  retrievalItems   TextbookRetrievalItem[]

  @@unique([revisionId, blockKey])
  @@unique([revisionId, position])
  @@index([sectionId, position])
}

model TextbookConcept {
  id             String   @id @default(uuid())
  revisionId     String
  sectionId      String
  name           String
  normalizedName String
  aliases        String[] @default([])
  kind           String
  explanation    String   @db.Text
  status         String   @default("ACTIVE")
  origin         String   @default("TEXTBOOK")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  revision          TextbookRevision          @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  section           TextbookSection           @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  evidence          TextbookConceptEvidence[]
  outgoingRelations TextbookConceptRelation[] @relation("TextbookRelationSource")
  incomingRelations TextbookConceptRelation[] @relation("TextbookRelationTarget")
  examples          TextbookConceptExample[]
  figures           TextbookConceptFigure[]
  retrievalItems    TextbookRetrievalItem[]

  @@unique([revisionId, normalizedName, sectionId])
  @@index([revisionId, status, normalizedName])
  @@index([sectionId, status])
}

model TextbookConceptEvidence {
  id            String   @id @default(uuid())
  conceptId     String
  sourceBlockId String
  quoteStart    Int
  quoteEnd      Int
  createdAt     DateTime @default(now())

  concept     TextbookConcept     @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  sourceBlock TextbookSourceBlock @relation(fields: [sourceBlockId], references: [id], onDelete: Cascade)

  @@unique([conceptId, sourceBlockId, quoteStart, quoteEnd])
  @@index([sourceBlockId])
}

model TextbookConceptRelation {
  id              String   @id @default(uuid())
  revisionId      String
  sourceConceptId String
  targetConceptId String
  relationType    String
  origin          String   @default("TEXTBOOK")
  sourceBlockId   String?
  confidence      Float?
  metadata        Json?
  createdAt       DateTime @default(now())

  revision      TextbookRevision     @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  sourceConcept TextbookConcept      @relation("TextbookRelationSource", fields: [sourceConceptId], references: [id], onDelete: Cascade)
  targetConcept TextbookConcept      @relation("TextbookRelationTarget", fields: [targetConceptId], references: [id], onDelete: Cascade)
  sourceBlock   TextbookSourceBlock? @relation(fields: [sourceBlockId], references: [id], onDelete: SetNull)

  @@unique([sourceConceptId, targetConceptId, relationType])
  @@index([revisionId, relationType])
  @@index([targetConceptId, relationType])
  @@index([sourceBlockId])
}

model TextbookExample {
  id            String   @id @default(uuid())
  revisionId    String
  sectionId     String
  sourceBlockId String?
  title         String?
  content       String   @db.Text
  origin        String   @default("TEXTBOOK")
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  revision       TextbookRevision         @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  section        TextbookSection          @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  sourceBlock    TextbookSourceBlock?     @relation(fields: [sourceBlockId], references: [id], onDelete: SetNull)
  concepts       TextbookConceptExample[]
  retrievalItems TextbookRetrievalItem[]

  @@index([revisionId, sectionId])
  @@index([sourceBlockId])
}

model TextbookConceptExample {
  conceptId String
  exampleId String

  concept TextbookConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  example TextbookExample @relation(fields: [exampleId], references: [id], onDelete: Cascade)

  @@id([conceptId, exampleId])
  @@index([exampleId])
}

model TextbookFigure {
  id            String   @id @default(uuid())
  revisionId    String
  sectionId     String?
  sourceBlockId String?
  fileAssetId   String
  caption       String?  @db.Text
  position      Int
  width         Int?
  height        Int?
  status        String   @default("AVAILABLE")
  metadata      Json?
  createdAt     DateTime @default(now())

  revision    TextbookRevision        @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  section     TextbookSection?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sourceBlock TextbookSourceBlock?    @relation(fields: [sourceBlockId], references: [id], onDelete: SetNull)
  fileAsset   FileAsset               @relation("TextbookFigureAsset", fields: [fileAssetId], references: [id], onDelete: Restrict)
  concepts    TextbookConceptFigure[]

  @@unique([revisionId, position])
  @@index([sectionId, position])
  @@index([sourceBlockId])
  @@index([fileAssetId])
}

model TextbookConceptFigure {
  conceptId String
  figureId  String

  concept TextbookConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  figure  TextbookFigure  @relation(fields: [figureId], references: [id], onDelete: Cascade)

  @@id([conceptId, figureId])
  @@index([figureId])
}

model TextbookRetrievalItem {
  id                 String                   @id @default(uuid())
  revisionId         String
  sectionId          String?
  sourceBlockId      String?
  conceptId          String?
  exampleId          String?
  kind               String
  title              String?
  content            String                   @db.Text
  searchTokens       String                   @db.Text
  searchVector       Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, COALESCE(\"searchTokens\", ''::text))"))
  contentFingerprint String
  position           Int
  metadata           Json?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  revision    TextbookRevision     @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  section     TextbookSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sourceBlock TextbookSourceBlock? @relation(fields: [sourceBlockId], references: [id], onDelete: Cascade)
  concept     TextbookConcept?     @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  example     TextbookExample?     @relation(fields: [exampleId], references: [id], onDelete: Cascade)
  embeddings  TextbookEmbedding[]

  @@unique([revisionId, kind, position])
  @@index([revisionId, sectionId, kind])
  @@index([contentFingerprint])
  @@index([sourceBlockId])
  @@index([conceptId])
  @@index([exampleId])
  @@index([searchVector], type: Gin)
}

model EmbeddingProfile {
  id                    String   @id @default(uuid())
  name                  String
  provider              String
  baseUrl               String?
  model                 String
  dimensions            Int      @default(1024)
  textProcessingVersion String
  configFingerprint     String   @unique
  status                String   @default("ACTIVE")
  isActive              Boolean  @default(false)
  credentialId          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  credential ProviderCredential? @relation("EmbeddingCredential", fields: [credentialId], references: [id], onDelete: SetNull)
  embeddings TextbookEmbedding[]

  @@index([status, isActive])
  @@index([credentialId])
}

model TextbookEmbedding {
  id                 String                       @id @default(uuid())
  retrievalItemId    String
  profileId          String
  contentFingerprint String
  status             String                       @default("PENDING")
  embedding          Unsupported("vector(1024)")?
  error              String?                      @db.Text
  attempt            Int                          @default(0)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  embeddedAt         DateTime?

  retrievalItem TextbookRetrievalItem @relation(fields: [retrievalItemId], references: [id], onDelete: Cascade)
  profile       EmbeddingProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([retrievalItemId, profileId, contentFingerprint])
  @@index([profileId, status])
  @@index([retrievalItemId, status])
}

model CourseTextbookBinding {
  id         String   @id @default(uuid())
  templateId String
  revisionId String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template  ClassroomTemplate               @relation(fields: [templateId], references: [id], onDelete: Cascade)
  revision  TextbookRevision                @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  sections  CourseTextbookSection[]
  snapshots CourseEvidenceSnapshotBinding[]

  @@unique([templateId, revisionId])
  @@index([templateId, isPrimary])
  @@index([revisionId])
}

model CourseTextbookSection {
  bindingId String
  sectionId String

  binding CourseTextbookBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  section TextbookSection       @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@id([bindingId, sectionId])
  @@index([sectionId])
}

model CourseEvidenceSnapshot {
  id          String   @id @default(uuid())
  templateId  String
  version     Int
  status      String   @default("DRAFT")
  isCurrent   Boolean  @default(false)
  fingerprint String
  payload     Json
  createdAt   DateTime @default(now())

  template ClassroomTemplate               @relation(fields: [templateId], references: [id], onDelete: Cascade)
  bindings CourseEvidenceSnapshotBinding[]

  @@unique([templateId, version])
  @@unique([templateId, fingerprint])
  @@index([templateId, isCurrent])
  @@index([status, createdAt])
}

model CourseEvidenceSnapshotBinding {
  snapshotId String
  bindingId  String

  snapshot CourseEvidenceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  binding  CourseTextbookBinding  @relation(fields: [bindingId], references: [id], onDelete: Restrict)

  @@id([snapshotId, bindingId])
  @@index([bindingId])
}

// ---------------------------------------------------------------------------
// Learning outcomes and evaluation
// ---------------------------------------------------------------------------

model ClassroomSubmission {
  id              String    @id @default(uuid())
  participationId String
  stageKey        String
  status          String    @default("DRAFT")
  payload         Json?
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  participation ClassroomParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@unique([participationId, stageKey])
  @@index([participationId, status])
}

model Artifact {
  id              String   @id @default(uuid())
  participationId String
  groupId         String?
  title           String
  type            String
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participation ClassroomParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  group         ProjectGroup?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  versions      ArtifactVersion[]
  showcases     ShowcasePresentation[]

  @@index([participationId, status])
  @@index([groupId, createdAt])
}

model ArtifactVersion {
  id          String    @id @default(uuid())
  artifactId  String
  sequence    Int
  sourceHtml  String?   @db.Text
  fileAssetId String?
  mimeType    String?
  sha256      String?
  size        BigInt?
  status      String    @default("DRAFT")
  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  artifact  Artifact               @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  fileAsset FileAsset?             @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  showcases ShowcasePresentation[]

  peerReviewAssignments PeerReviewAssignment[]

  @@unique([artifactId, sequence])
  @@index([fileAssetId])
}

model ShowcasePresentation {
  id                String    @id @default(uuid())
  artifactId        String
  artifactVersionId String?
  participationId   String
  groupId           String?
  status            String    @default("PENDING")
  scheduledAt       DateTime?
  presentedAt       DateTime?
  content           Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  artifact        Artifact               @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  artifactVersion ArtifactVersion?       @relation(fields: [artifactVersionId], references: [id], onDelete: SetNull)
  participation   ClassroomParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  group           ProjectGroup?          @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([participationId, status])
  @@index([groupId, scheduledAt])
}

model Reflection {
  id              String   @id @default(uuid())
  participationId String
  activityId      String?
  authorId        String?
  content         String   @db.Text
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participation ClassroomParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  activity      Activity?              @relation(fields: [activityId], references: [id], onDelete: SetNull)
  author        User?                  @relation("ReflectionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([participationId, createdAt])
}

model Evaluation {
  pblKey          String?  @unique
  id              String   @id @default(uuid())
  participationId String
  studentId       String?
  groupId         String?
  activityId      String?
  type            String
  evaluatorType   String
  evaluatorId     String?
  score           Decimal? @db.Decimal(10, 2)
  rubric          Json?
  result          Json?
  content         String?  @db.Text
  metadata        Json?
  createdAt       DateTime @default(now())

  participation ClassroomParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  student       User?                  @relation("EvaluationStudent", fields: [studentId], references: [id], onDelete: SetNull)
  group         ProjectGroup?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  activity      Activity?              @relation(fields: [activityId], references: [id], onDelete: SetNull)
  evaluator     User?                  @relation("EvaluationEvaluator", fields: [evaluatorId], references: [id], onDelete: SetNull)

  @@index([participationId, createdAt])
  @@index([activityId, type])
  @@index([studentId, createdAt])
}

// ---------------------------------------------------------------------------
// Collaboration and course content
// ---------------------------------------------------------------------------

model ProjectGroup {
  id         String   @id @default(uuid())
  offeringId String
  name       String
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  offering      CourseOffering         @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  members       GroupMember[]
  workPlanItems WorkPlanItem[]
  board         GroupBoard?
  artifacts     Artifact[]
  showcases     ShowcasePresentation[]
  evaluations   Evaluation[]
  announcements Announcement[]
  todos         Todo[]
  interventions Intervention[]

  @@index([offeringId, status])
}

model GroupMember {
  id              String    @id @default(uuid())
  groupId         String
  userId          String
  participationId String?
  role            String    @default("MEMBER")
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?

  group         ProjectGroup            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  participation ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: SetNull)

  @@unique([groupId, userId])
  @@index([participationId])
}

model WorkPlanItem {
  id          String    @id @default(uuid())
  groupId     String
  activityId  String?
  assigneeId  String?
  title       String
  description String?   @db.Text
  status      String    @default("TODO")
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  group    ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  activity Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)
  assignee User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([groupId, status, dueAt])
}

model GroupBoard {
  id        String   @id @default(uuid())
  groupId   String   @unique
  snapshot  Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Announcement {
  id                  String    @id @default(uuid())
  offeringId          String
  groupId             String?
  classroomInstanceId String?
  createdById         String
  scope               String
  title               String
  content             String    @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  archivedAt          DateTime?

  offering          CourseOffering      @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  group             ProjectGroup?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  classroomInstance ClassroomInstance?  @relation(fields: [classroomInstanceId], references: [id], onDelete: Cascade)
  createdBy         User                @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  replies           AnnouncementReply[]

  @@index([offeringId, scope, createdAt])
  @@index([groupId, createdAt])
}

model AnnouncementReply {
  id             String   @id @default(uuid())
  announcementId String
  authorId       String
  content        String   @db.Text
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([announcementId, createdAt])
}

model Todo {
  id          String    @id @default(uuid())
  offeringId  String
  groupId     String?
  activityId  String?
  createdById String
  title       String
  description String?   @db.Text
  status      String    @default("ACTIVE")
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  offering    CourseOffering   @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  group       ProjectGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  activity    Activity?        @relation(fields: [activityId], references: [id], onDelete: SetNull)
  createdBy   User             @relation("TodoCreator", fields: [createdById], references: [id], onDelete: Restrict)
  completions TodoCompletion[]

  @@index([offeringId, status, dueAt])
}

model TodoCompletion {
  id          String   @id @default(uuid())
  todoId      String
  userId      String
  completedAt DateTime @default(now())

  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([todoId, userId])
}

model Resource {
  id          String   @id @default(uuid())
  offeringId  String
  activityId  String?
  fileAssetId String?  @unique
  createdById String
  title       String
  description String?  @db.Text
  type        String
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offering  CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  activity  Activity?      @relation(fields: [activityId], references: [id], onDelete: SetNull)
  fileAsset FileAsset?     @relation("ResourceAsset", fields: [fileAssetId], references: [id], onDelete: SetNull)
  createdBy User           @relation("ResourceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([offeringId, type])
}

model FileAsset {
  id                 String    @id @default(uuid())
  storageKey         String    @unique
  originalName       String
  mimeType           String
  size               BigInt
  sha256             String?
  // SOURCE is irreplaceable user/course data. Derived roles describe bytes
  // that can be rebuilt from sourceAsset + regenerationRecipe after restore.
  assetRole          String    @default("SOURCE")
  backupPolicy       String    @default("REQUIRED")
  sourceAssetId      String?
  regenerationRecipe Json?
  uploadedById       String
  offeringId         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  uploadedBy       User              @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  offering         CourseOffering?   @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  resource         Resource?         @relation("ResourceAsset")
  artifactVersions ArtifactVersion[]
  sourceAsset      FileAsset?        @relation("DerivedAssetSource", fields: [sourceAssetId], references: [id], onDelete: Restrict)
  derivedAssets    FileAsset[]       @relation("DerivedAssetSource")
  textbookRevision TextbookRevision? @relation("TextbookRevisionSource")
  textbookFigures  TextbookFigure[]  @relation("TextbookFigureAsset")

  @@index([offeringId, createdAt])
  @@index([sha256])
  @@index([sourceAssetId])
  @@index([backupPolicy, deletedAt])
}

// ---------------------------------------------------------------------------
// AI assistance and teaching support
// ---------------------------------------------------------------------------

model AiConversation {
  id              String    @id @default(uuid())
  userId          String
  offeringId      String?
  participationId String?
  title           String?
  status          String    @default("OPEN")
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  closedAt        DateTime?

  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  offering          CourseOffering?         @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  participation     ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Cascade)
  messages          AiMessage[]
  tasks             AiTask[]
  interactionEvents AiInteractionEvent[]

  @@index([userId, updatedAt])
  @@index([participationId, updatedAt])
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  userId         String?
  role           String
  content        String   @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

model AiTask {
  requestAliases AiTaskRequestAlias[]
  id             String               @id @default(uuid())
  conversationId String?
  offeringId     String?
  createdById    String
  taskType       String
  status         String               @default("PENDING")
  queueKey       String?
  availableAt    DateTime?
  leaseUntil     DateTime?
  attemptCount   Int                  @default(0)
  input          Json?
  output         Json?
  error          String?              @db.Text
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  conversation      AiConversation?       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  offering          CourseOffering?       @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  createdBy         User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  confirmation      AiActionConfirmation?
  interactionEvents AiInteractionEvent[]

  @@index([createdById, status, createdAt])
  @@index([offeringId, status])
  @@index([queueKey, status, availableAt])
  @@index([queueKey, createdById, startedAt])
}

model AiTaskRequestAlias {
  participationId String
  clientRequestId String
  taskId          String
  bodyDigest      String
  requestBody     Json
  createdAt       DateTime @default(now())

  participation ClassroomParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  task          AiTask                 @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([participationId, clientRequestId])
  @@index([taskId])
}

model AiActionConfirmation {
  id            String    @id @default(uuid())
  taskId        String?   @unique
  offeringId    String?
  requestedById String
  decidedById   String?
  actionType    String
  payload       Json?
  status        String    @default("PENDING")
  expiresAt     DateTime?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  task        AiTask?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  offering    CourseOffering? @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  requestedBy User            @relation("ConfirmationRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy   User?           @relation("ConfirmationDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([requestedById, status, createdAt])
}

model AiSupportRecord {
  id                String    @id @default(uuid())
  offeringId        String
  participationId   String?
  createdById       String
  type              String
  status            String    @default("OPEN")
  summary           String?   @db.Text
  structuredPayload Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  resolvedAt        DateTime?

  offering      CourseOffering          @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  participation ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Cascade)
  createdBy     User                    @relation("SupportCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([offeringId, type, status])
  @@index([participationId, createdAt])
}

model LearningSignal {
  id              String   @id @default(uuid())
  userId          String
  offeringId      String
  enrollmentId    String?
  participationId String?
  type            String
  status          String   @default("OPEN")
  severity        String?
  payload         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  offering      CourseOffering          @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  enrollment    Enrollment?             @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  participation ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, status, updatedAt])
  @@index([offeringId, type, updatedAt])
}

model Intervention {
  id              String   @id @default(uuid())
  offeringId      String
  enrollmentId    String?
  participationId String?
  groupId         String?
  channel         String
  type            String
  content         String?  @db.Text
  createdById     String
  occurredAt      DateTime @default(now())
  metadata        Json?

  offering      CourseOffering          @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  enrollment    Enrollment?             @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  participation ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Cascade)
  group         ProjectGroup?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy     User                    @relation("InterventionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([offeringId, occurredAt])
  @@index([participationId, occurredAt])
}

model TeacherAgentDirective {
  id              String    @id @default(uuid())
  offeringId      String
  participationId String?
  createdById     String
  directiveType   String
  payload         Json
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?

  offering      CourseOffering          @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  participation ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Cascade)
  createdBy     User                    @relation("DirectiveCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([offeringId, status, createdAt])
  @@index([participationId, status])
}

// ---------------------------------------------------------------------------
// Append-only learning, AI and domain events
// ---------------------------------------------------------------------------

model LearningEvent {
  id                  String   @id @default(uuid())
  idempotencyKey      String
  // Snapshot survives context removal; historical rows are backfilled only when ownership matches.
  researchKey         String?
  userId              String
  offeringId          String?
  enrollmentId        String?
  chapterId           String?
  activityId          String?
  classroomInstanceId String?
  participationId     String?
  eventType           String
  occurredAt          DateTime
  receivedAt          DateTime @default(now())
  source              String?
  durationMs          Int?
  metadata            Json?
  eventVersion        Int      @default(1)

  user              User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  offering          CourseOffering?         @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  enrollment        Enrollment?             @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  chapter           Chapter?                @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  activity          Activity?               @relation(fields: [activityId], references: [id], onDelete: Restrict)
  classroomInstance ClassroomInstance?      @relation(fields: [classroomInstanceId], references: [id], onDelete: Restrict)
  participation     ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([classroomInstanceId, eventType])
  @@index([offeringId, receivedAt, id])
  @@index([researchKey, occurredAt])
  @@index([offeringId, enrollmentId, occurredAt])
  @@index([offeringId, activityId, occurredAt])
  @@index([eventType, occurredAt])
}

model AiInteractionEvent {
  id              String   @id @default(uuid())
  researchKey     String?
  idempotencyKey  String   @unique
  userId          String
  offeringId      String?
  conversationId  String?
  taskId          String?
  participationId String?
  requestId       String?
  eventType       String
  actor           String
  content         String?  @db.Text
  payload         Json?
  createdAt       DateTime @default(now())

  user          User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  offering      CourseOffering?         @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  conversation  AiConversation?         @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  task          AiTask?                 @relation(fields: [taskId], references: [id], onDelete: Restrict)
  participation ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@index([researchKey, createdAt])
  @@index([offeringId, createdAt, id])
  @@index([participationId, createdAt])
  @@index([userId, createdAt])
  @@index([requestId])
}

model DomainEvent {
  id                  String   @id @default(uuid())
  researchKey         String?
  idempotencyKey      String   @unique
  actorId             String?
  offeringId          String?
  classroomInstanceId String?
  participationId     String?
  eventType           String
  payload             Json?
  createdAt           DateTime @default(now())

  actor             User?                   @relation("DomainEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  offering          CourseOffering?         @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  classroomInstance ClassroomInstance?      @relation(fields: [classroomInstanceId], references: [id], onDelete: Restrict)
  participation     ClassroomParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@index([researchKey, createdAt])
  @@index([offeringId, createdAt, id])
  @@index([offeringId, createdAt])
  @@index([eventType, createdAt])
}

// ---------------------------------------------------------------------------
// Infrastructure
// ---------------------------------------------------------------------------

model ProviderCredential {
  id        String    @id @default(uuid())
  ownerId   String?
  provider  String
  name      String
  secret    String
  config    Json?
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  rotatedAt DateTime?

  owner             User?              @relation("CredentialOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  embeddingProfiles EmbeddingProfile[] @relation("EmbeddingCredential")

  @@unique([ownerId, provider, name])
  @@index([provider, status])
}

model LoadTestRun {
  id            String    @id @default(uuid())
  initiatedById String?
  name          String
  status        String    @default("PENDING")
  config        Json
  result        Json?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  initiatedBy User? @relation("LoadTestInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// No student identity or conversation content belongs in shared explanations.
model KnowledgeExplanation {
  id              String    @id
  contentKey      String?
  status          String    @default("PENDING")
  input           Json
  raw             String?   @db.Text
  error           String?
  token           String?
  leaseUntil      DateTime?
  retryAt         DateTime?
  audio           Json?
  audioToken      String?
  audioLeaseUntil DateTime?
  audioError      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, leaseUntil])
  @@index([contentKey, status])
}

// Publication commits this receipt; startup resumes unfinished warmups.
model KnowledgeExplanationWarmup {
  id         String    @id
  courseId   String
  input      Json
  status     String    @default("PENDING")
  attempts   Int       @default(0)
  error      String?
  token      String?
  leaseUntil DateTime?
  retryAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, retryAt, createdAt])
}

// Each assignment pins a formally submitted immutable version.
model PeerReviewAssignment {
  id                      String   @id @default(uuid())
  instanceId              String
  reviewerParticipationId String
  targetParticipationId   String
  artifactVersionId       String
  status                  String   @default("ACTIVE")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  instance        ClassroomInstance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  reviewer        ClassroomParticipation @relation("PeerReviewer", fields: [reviewerParticipationId], references: [id], onDelete: Cascade)
  target          ClassroomParticipation @relation("PeerTarget", fields: [targetParticipationId], references: [id], onDelete: Cascade)
  artifactVersion ArtifactVersion        @relation(fields: [artifactVersionId], references: [id], onDelete: Restrict)

  @@unique([instanceId, reviewerParticipationId, targetParticipationId])
  @@index([reviewerParticipationId, status])
  @@index([targetParticipationId, status])
}
