# Timing only: no cookies, credentials, query strings or request bodies.
# Docker rotates stdout logs using the existing 50 MiB x 5 policy.
log_format classroom_action_timing escape=json
    '{"kind":"classroom-action-timing","at":"$msec","requestId":"$request_id",'
    '"status":$status,"requestSeconds":$request_time,"upstreamSeconds":"$upstream_response_time",'
    '"connectSeconds":"$upstream_connect_time","headerSeconds":"$upstream_header_time",'
    '"serverTiming":"$upstream_http_server_timing"}';

upstream openpbl_app {
    server ${OPENPBL_UPSTREAM_HOST}:3000;
    keepalive 256;
    keepalive_timeout 60s;
}

upstream openpbl_ws {
    server ${OPENPBL_UPSTREAM_HOST}:3001;
    keepalive 32;
}

# A whole classroom commonly shares one campus NAT address. Application-level
# limits key authenticated writes by user and course; this edge limit is only
# a broad abuse ceiling. Leave room for 40 browsers fetching pages, profiles,
# course data and Next.js navigation prefetches together (up to 30 per browser).
limit_req_zone $binary_remote_addr zone=general:10m rate=300r/s;
limit_req_zone $binary_remote_addr zone=uploads:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=projection_reads:10m rate=300r/s;
limit_req_zone $binary_remote_addr zone=media_reads:10m rate=300r/s;
# HTTP/2 counts each concurrent resource request as a connection. Forty cold
# browsers must be able to fetch their JS/CSS/fonts without consuming the
# shared campus ceiling for application requests. Empty keys are not counted.
map $uri $application_connection_key {
    default $binary_remote_addr;
    ~^/(_next/static|brand)/ "";
}
limit_conn_zone $application_connection_key zone=per_ip_application:10m;
# A WebSocket must not consume the HTTP request budget for every campus user.
limit_conn_zone $binary_remote_addr zone=per_ip_websocket:10m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Next.js supplies SAMEORIGIN only for the isolated resource runtime. Avoid a
# conflicting edge DENY there while preserving it for every other URI.
map $uri $openpbl_frame_options {
    default "DENY";
    /internal/resource-player "";
}

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml application/wasm;

client_body_buffer_size 1m;
client_max_body_size 501m;
client_header_timeout 15s;
client_body_timeout 600s;
send_timeout 60s;
server_tokens off;

server {
    listen 80;
    server_name ${PUBLIC_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri =404;
    }

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

# Docker-internal monitoring listener. Port 8080 is not published by Compose.
server {
    listen ${NGINX_INTERNAL_LISTEN};
    server_name _;

    location = /api/metrics {
        proxy_pass http://openpbl_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
    }

    location = /api/health/ready {
        proxy_pass http://openpbl_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
    }

    location / {
        return 404;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_HOST};

    ssl_certificate /etc/letsencrypt/live/${PUBLIC_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options $openpbl_frame_options always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(self), geolocation=()" always;
    # Preserve the application's request-specific CSP (including the current
    # origin for sandboxed runtimes). This additional policy only enforces
    # HTTPS upgrades; multiple CSP policies are enforced together by browsers.
    add_header Content-Security-Policy "upgrade-insecure-requests" always;

    proxy_hide_header X-Powered-By;
    # Do not hide or replace the application's script/connect source policy.
    proxy_http_version 1.1;
    # Reuse the configured upstream keepalive pool for ordinary HTTP.
    # WebSocket locations explicitly override this with their upgrade header.
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-Id $request_id;
    proxy_connect_timeout 10s;
    # One classroom can share a campus NAT address. Keep a bounded ceiling,
    # with static bundles accounted for separately from application requests.
    # 42 cold browsers issue multiple concurrent API/RSC requests per page.
    limit_conn per_ip_application 1024;

    location = /api/metrics { return 404; }
    location = /api/health/ready { return 404; }
    location ^~ /api/load-test/ {
        allow ${LOAD_TEST_CLIENT_IP};
        deny all;
        proxy_pass http://openpbl_app;
    }

    location = /api/health/live {
        access_log off;
        proxy_pass http://openpbl_app;
    }

    location /ws {
        limit_conn per_ip_websocket 150;
        proxy_pass http://openpbl_ws;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location ~ ^/api/courses/[^/]+/actions$ {
        access_log /dev/stdout classroom_action_timing;
        include /etc/nginx/openpbl-edge-location/*.conf;
        limit_req zone=general burst=1200 nodelay;
        proxy_pass http://openpbl_app;
    }

    location ~ ^/api/courses/[^/]+/projection$ {
        limit_req zone=projection_reads burst=600 nodelay;
        proxy_pass http://openpbl_app;
        proxy_buffering off;
    }

    # Agent tools can be silent while regenerating a slide; this is SSE too.
    location ~* ^/api/(.*/stream|openmaic/(chat|agent/edit)|chat/.*)$ {
        limit_req zone=general burst=1200 nodelay;
        proxy_pass http://openpbl_app;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        gzip off;
    }

    # Project-practice AI can require an assessment and a deliverable response.
    # The ordinary 60-second page limit would close the request before it ends.
    location ~ ^/api/ai-collaboration/(document|code)$ {
        limit_req zone=general burst=1200 nodelay;
        proxy_pass http://openpbl_app;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    location = /api/uploads {
        limit_req zone=uploads burst=80 nodelay;
        client_max_body_size 501m;
        client_body_timeout 600s;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_pass http://openpbl_app;
    }

    location ~ ^/api/uploads/[0-9a-fA-F-]+$ {
        limit_req zone=media_reads burst=600 nodelay;
        proxy_pass http://openpbl_app;
        proxy_set_header X-OpenPBL-Accel-Redirect 1;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location ^~ /_openpbl_uploads/ {
        internal;
        alias /srv/openpbl/uploads/;
        sendfile on;
        aio threads;
        tcp_nopush on;
    }

    location ^~ /_next/static/ {
        proxy_pass http://openpbl_app;
        # Preserve Next's immutable successes and no-store errors unchanged.
        access_log off;
    }

    # Stable parser URLs must revalidate, including after a release switch.
    location ^~ /vendor/ {
        proxy_pass http://openpbl_app;
        access_log off;
    }

    location /_next/image {
        proxy_pass http://openpbl_app;
        add_header Cache-Control "public, max-age=86400";
        access_log off;
    }

    location / {
        limit_req zone=general burst=1200 nodelay;
        proxy_pass http://openpbl_app;
        proxy_read_timeout 60s;
    }
}
