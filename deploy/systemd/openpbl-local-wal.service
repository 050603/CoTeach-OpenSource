[Unit]
Description=CoTeach continuous local PostgreSQL WAL receiver
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/OpenPBL/openPBL
ExecStart=/usr/bin/python3 %h/OpenPBL/openPBL/deploy/backup/local-backup.py wal
ExecStop=-/usr/bin/docker stop --time 15 openpbl-local-wal
Restart=always
RestartSec=10s
TimeoutStopSec=30s
UMask=0077

[Install]
WantedBy=default.target
