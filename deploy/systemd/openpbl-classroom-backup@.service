[Unit]
Description=CoTeach finite classroom research backup and sealing (%i)
After=openpbl.service

[Service]
Type=oneshot
WorkingDirectory=%h/OpenPBL/openPBL
ExecStart=/usr/bin/python3 %h/OpenPBL/openPBL/deploy/backup/classroom-research-backup.py tick --session %i
TimeoutStartSec=30min
UMask=0077
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
