[Unit]
Description=CoTeach production code runner (loopback port 3002)
PartOf=openpbl.service
Before=openpbl.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/OpenPBL/openPBL
Environment=OPENPBL_CODE_RUNNER_PORT=3002
ExecStart=%h/OpenPBL/openPBL/scripts/openpbl-production-service.sh run-code-runner
Restart=always
RestartSec=5s
TimeoutStopSec=15s
KillMode=control-group
SuccessExitStatus=143
LimitNOFILE=65535

[Install]
WantedBy=default.target
