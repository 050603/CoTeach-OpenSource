[Unit]
Description=CoTeach offline neural survey tokenizer (loopback port 3003)
PartOf=openpbl.service
Before=openpbl.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/OpenPBL/openPBL
ExecStart=%h/OpenPBL/openPBL/scripts/openpbl-production-service.sh run-survey-nlp
ExecStartPost=/usr/bin/curl --fail --silent --show-error --retry 30 --retry-connrefused --retry-delay 1 --max-time 2 http://127.0.0.1:3003/health/live
Restart=always
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=15s
KillMode=control-group
SuccessExitStatus=143

[Install]
WantedBy=default.target
