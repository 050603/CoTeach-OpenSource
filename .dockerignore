# OpenPBL Docker build context filter.
#
# Excludes anything that isn't needed for `next build` so the build context
# stays small and the build cache isn't invalidated by local artifacts.

# ---- Secrets — never bake into a layer ----
.env*
**/.env*
!.env.example
server-providers.yml
**/server-providers.yml
*.pem
**/*.pem
*.key
**/*.key
*.crt
**/*.crt

# ---- Dependencies & build artifacts (regenerated inside the image) ----
node_modules
**/node_modules
.next*
**/.next*
out
**/out
dist
**/dist
build
**/build
coverage
**/coverage
.nyc_output
**/.nyc_output

# ---- Local runtime data (must NOT ship inside the image) ----
.openpbl-data
**/.openpbl-data
.openpbl-runtime
**/.openpbl-runtime
.cache
**/.cache
data
backups
**/backups
artifacts
output
# Rebuilt by the production build and dependency installation.
workers
public/vendor/maic-importer
public/vendor/pdfjs

# ---- Version control / IDE ----
.git
.gitignore
.gitattributes
.github
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Test & QA artifacts ----
playwright-report
playwright/.cache
test-results
.turbo
*.lcov

# ---- Docs & metadata not consumed by the build ----
docs
.trae
CLAUDE.md
AGENTS.md
DESIGN-SYSTEM.md
VERSIONING.md
README.md
**/README.md
**/CHANGELOG.md
# Third-party LICENSE files must remain available to distribution builds.
SECURITY.md
CONTRIBUTING.md
!licenses/README.md

# ---- Upstream reference repo (not part of this build) ----
OpenMAIC-main

# ---- Misc files that don't affect the build ----
.vercel
.eslintcache
*.tsbuildinfo
server-providers.example.yml
AI伴学项目式课堂模式_说明文档*.md

# ---- Docker artifacts themselves (avoid recursive context bloat) ----
Dockerfile
docker-compose*.yml
.dockerignore
deploy
# container-entrypoint.sh is COPY'd by the Dockerfile (migrator/runner stages)
!deploy/container-entrypoint.sh
!deploy/backup/manual-essential-backup.sh

# ---- Examples / sample data ----
*.example.yml
