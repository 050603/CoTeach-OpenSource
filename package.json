  "scripts": {
    "predev": "node scripts/build-document-converter-worker.mjs && node scripts/build-course-read-worker.mjs && node scripts/run-prisma.mjs ensure",
    "dev": "next dev",
    "build": "node scripts/run-production-task.mjs build",
    "start": "node scripts/run-next-production.mjs start",
    "code-runner": "node scripts/code-runner-server.mjs",
    "lint": "eslint",
    "lint:ci": "eslint --max-warnings 0",
    "typecheck": "node scripts/run-production-task.mjs typecheck",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:prod": "pnpm audit --prod --audit-level=high --registry=https://registry.npmjs.org/",
    "test:e2e": "playwright test",
    "verify:prelaunch": "node scripts/run-prelaunch-audit.mjs",
    "test:classroom-acceptance": "node scripts/run-classroom-acceptance.mjs",
    "test:classroom-flow": "node scripts/verify-research-database.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:projection-sync": "node scripts/measure-projection-sync.mjs",
    "playwright:install": "playwright install chromium",
    "db:generate": "node scripts/run-prisma.mjs generate",
    "db:migrate": "node scripts/run-prisma.mjs migrate dev",
    "db:migrate:prod": "node scripts/run-prisma.mjs migrate deploy",
    "db:status": "node scripts/run-prisma.mjs migrate status",
    "test:db:research": "node scripts/verify-research-database.mjs",
    "db:studio": "node scripts/run-prisma.mjs studio",
    "cleanup:uploads": "tsx --env-file=.env.local scripts/cleanup-uploads.ts orphans",
    "storage:rehydrate": "tsx --env-file=.env.local scripts/rehydrate-storage.ts",
    "admin:init-teacher": "tsx --env-file=.env.local scripts/init-teacher.ts",
    "postinstall": "cd packages/mathml2omml && pnpm run build && cd ../pptxgenjs && pnpm run build && cd ../@openmaic/dsl && pnpm run build && cd ../generation && pnpm run build && cd ../importer && pnpm run build && cd ../renderer && pnpm run build && cd ../../.. && node scripts/sync-maic-importer.mjs && node scripts/run-prisma.mjs generate",
    "test:course-generation-acceptance": "vitest run --config tests/course-generation-acceptance/vitest.config.ts"
  },
