# ============================================================================
# CoTeach environment variables (OPENPBL_* remains the configuration namespace)
# ============================================================================
# 当前入口：课程平台、教材库与五阶段课堂。
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. NEVER commit the
# populated file. The runtime reads variables from `process.env`; in Docker,
# `docker-compose.yml` mounts `.env.local` via `env_file:` and interpolates a
# few `${VARIABLE}` references at compose-up time (POSTGRES_PASSWORD below).
# ----------------------------------------------------------------------------

# Optional environment-based LLM configuration for course generation.
# Teachers normally configure providers in Personal Center → AI Services.
# Missing model configuration returns a configuration error for real generation.
OPENPBL_LLM_ENDPOINT=
OPENPBL_LLM_API_KEY=
OPENPBL_LLM_MODEL=

# Optional OpenMAIC-compatible provider credentials. The teacher settings page
# stores the same values encrypted in PostgreSQL; environment variables remain
# useful for immutable deployments. MODELS values are comma-separated.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODELS=your-model-id
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai
# AZURE_OPENAI_MODELS=YOUR_DEPLOYMENT_NAME
# ATLASCLOUD_API_KEY=
# ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/v1
# ATLASCLOUD_MODELS=your-model-id
# BEDROCK_REGION=us-east-1
# BEDROCK_MODELS=your-model-id
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Ordinary structured calls use a 3-minute deadline. Deep quality reviews use
# 5 minutes, while output-heavy curriculum calls (knowledge graph, lecture
# outline, page generation, full course) use 10 minutes. Values are milliseconds and
# are clamped between 30s and 30min.
OPENPBL_LLM_REQUEST_TIMEOUT_MS=180000
OPENPBL_LLM_QUALITY_REVIEW_TIMEOUT_MS=300000
OPENPBL_LLM_LONG_REQUEST_TIMEOUT_MS=600000

# Teacher-side classroom generation uses four concurrent scene workers by
# default. Set 1 for serial generation, or tune within the supported 1-5 range.
PARALLEL_SCENE_CONCURRENCY=4

# Process-wide cap shared by background course-design and classroom LLM calls.
# Keep this at or below the provider's stable parallel-request quota (1-5).
COURSE_GENERATION_LLM_CONCURRENCY=4

# Native classroom tools (whiteboard, quick checks, evidence-board updates,
# and embedded widgets) are enabled unless this is explicitly set to false.
# Keep the switch available as a rollback path for custom model providers.
OPENMAIC_NATIVE_CLASSROOM_TOOLS=true

# TTS uses conservative provider metadata defaults (normally 2 segments, up to
# 4). Override globally or per provider, for example:
# TTS_CONCURRENCY=2
# TTS_OPENAI_TTS_CONCURRENCY=4

# ============================================================================
# Database and production services
# ============================================================================

# PostgreSQL connection string. Required for accounts, the course platform,
# textbook evidence and durable jobs. Use PostgreSQL 16 with pgvector.
# JSON compatibility files do not replace this database. Apply committed
# migrations with `pnpm db:migrate:prod` only to the intended database.
# In docker-compose, the app service sets this automatically to
# `postgresql://openpbl:${POSTGRES_PASSWORD}@postgres:5432/openpbl` — only set
# DATABASE_URL here if you're running the app outside compose.
# Example: postgresql://openpbl:password@localhost:5432/openpbl
DATABASE_URL=

# Optional shared source of truth for AI provider settings. A test deployment
# may keep its own DATABASE_URL for users/courses while reading the formal
# system's global ProviderCredential rows through this connection.
PROVIDER_CONFIG_DATABASE_URL=

# Public base URL of the deployment. Used to build absolute URLs in course
# generation callbacks. Required in production; localhost fallback is disabled.
# Example: https://openpbl.example.com
PUBLIC_BASE_URL=
# Local development defaults to request-bound generation. Production enables
# durable background generation automatically; this explicit switch is useful
# for self-hosted environments that need to override that default.
COURSE_GENERATION_BACKGROUND_ENABLED=false

# Secret used to sign JWT auth cookies. Must be a long random string.
# Generate with: `openssl rand -base64 48`
JWT_SECRET=

# AES-256-GCM key for encrypting provider credentials at rest.
# Generate with: openssl rand -base64 32
PROVIDER_ENCRYPTION_KEY=
# Required when PROVIDER_CONFIG_DATABASE_URL points at another deployment;
# use the same value as that formal system so its provider secrets can decrypt.
PROVIDER_CONFIG_ENCRYPTION_KEY=

# Protects readiness and Prometheus endpoints on the internal Nginx location.
# Generate with: openssl rand -base64 32
INTERNAL_MONITOR_TOKEN=
ENABLE_LOAD_TEST_API=false
LOAD_TEST_ADMIN_TOKEN=
# Compatibility variables; current capacity verification uses scoped test users
# and the real platform APIs. See tests/load/README.md for supported entrypoints.

# Required in the supplied production Compose stack. The application trusts
# X-Real-IP only because Nginx overwrites it and the app port is not public.
TRUST_PROXY_HEADERS=true

# Redis is used for cross-instance realtime invalidation delivery.
# Example: redis://localhost:6379
REDIS_URL=

# Realtime server. Browser clients use same-origin /ws by default; set the
# public URL only for development without the supplied Nginx proxy.
ENABLE_WEBSOCKET=true
WEBSOCKET_PORT=3001
NEXT_PUBLIC_WEBSOCKET_URL=

# Uploaded classroom presentation previews. PPTX source files are preserved,
# while LibreOffice creates the PDF used for preview and synchronized screen
# sharing. If conversion is unavailable or fails, teachers are asked to upload
# a PDF instead; the browser does not rebuild PPT elements.
# Keep automatic conversion disabled by default: PDF can freeze the converter's
# output, but it cannot repair font substitution or shape reflow that happened
# while LibreOffice opened the PPTX. Enable only for controlled templates.
OPENPBL_PPTX_CLASSROOM_CONVERSION_ENABLED=false
OPENPBL_PRESENTATION_CONVERTER_BIN=libreoffice
OPENPBL_PRESENTATION_CONVERSION_TIMEOUT_MS=90000
OPENPBL_PRESENTATION_PREVIEW_MAX_BYTES=104857600

# ============================================================================
# Docker Compose only — NOT read by the app directly.
# `docker-compose.yml` interpolates these into the postgres service env.
# ============================================================================
# Password for the `openpbl` Postgres role. Generate with:
#   `openssl rand -base64 32`
# This value is interpolated into POSTGRES_PASSWORD on the postgres service
# and into DATABASE_URL on the app service at `docker compose up` time.
POSTGRES_PASSWORD=
