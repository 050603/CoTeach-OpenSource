{
  "name": "@openmaic/importer",
  "version": "0.1.2",
  "description": "A javascript tool for parsing .pptx file",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean:dist": "rimraf dist",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && rollup -c && tsc --emitDeclarationOnly",
    "dev": "rollup -c -w",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build",
    "transvert:pro": "npx tsx scripts/transvert.ts"
  },
  "keywords": [
    "ppt",
    "pptx",
    "json"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/THU-MAIC/OpenMAIC",
    "directory": "packages/@openmaic/importer"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@openmaic/dsl": "workspace:*",
    "@xmldom/xmldom": "^0.9.9",
    "dom-node-types": "1.0.1",
    "jpegxr": "^0.3.0",
    "jszip": "^3.10.1",
    "katex": "^0.18.2",
    "mathml-to-latex": "1.5.0",
    "nanoid": "^5.1.6",
    "omml2mathml": "workspace:*",
    "pdfjs-dist": "4.8.69",
    "pptxtojson": "^1.11.0",
    "tinycolor2": "1.6.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-terser": "^0.1.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^3.3.0",
    "rollup-plugin-node-builtins": "^2.1.2",
    "rollup-plugin-node-globals": "^1.4.0",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
